# Pharmasense Environment Variables — TEMPLATE
# Copy this to .env and fill in your values
# NEVER commit .env — it is gitignored

# ── LLM ──────────────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Weather ───────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────
# Get from: twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Production: get from upstash.io
REDIS_URL=redis://localhost:6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Local dev: localhost:9092
# Production: get from upstash.io/kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_OUTBREAK_TOPIC=outbreak_events

# ── Service URLs (overridden in Docker Compose) ───────────────────────────────
ML_SERVICE_GRPC_HOST=localhost:50051
GATEWAY_HOST=localhost:8080
ML_SERVICE_HTTP_HOST=http://localhost:8000

# ── ML Model Artifact Paths ────────────────────────────────────────────────────
STGNN_MODEL_PATH=ml/artifacts/stgnn_latest.pt
TFT_MODEL_PATH=ml/artifacts/tft_latest.pt

# ── App Config ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
