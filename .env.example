# ─── Pharmasense Environment Variables — TEMPLATE ────────────────────────────
# Copy this to .env and fill in your values
# DO NOT COMMIT .env. It is in .gitignore.

# ── LLM ──────────────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Weather ───────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_SECRET=your_twilio_webhook_secret_here

# ── Supabase — Project A (Operational DB) ─────────────────────────────────────
# hospitals | districts | drugs | inventory | risk_scores | purchase_orders etc.
SUPABASE_URL_A=https://your-project-a.supabase.co
SUPABASE_ANON_KEY_A=your_supabase_anon_key_a_here
SUPABASE_SERVICE_ROLE_KEY_A=your_supabase_service_role_key_a_here
SUPABASE_DB_URL_A=postgresql://postgres.your-project-a:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_JWT_SECRET_A=your_supabase_jwt_secret_a_here

# ── Supabase — Project B (Training Data — ML notebooks only) ──────────────────
# ncd_demand_weekly | malaria_weekly — never touched by production service
SUPABASE_URL_B=https://your-project-b.supabase.co
SUPABASE_ANON_KEY_B=your_supabase_anon_key_b_here
SUPABASE_SERVICE_ROLE_KEY_B=your_supabase_service_role_key_b_here
SUPABASE_DB_URL_B=postgresql://postgres.your-project-b:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Production: Upstash TLS URL → rediss://...
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=20

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Local dev: localhost:9092 (Docker Compose)
# Production: Upstash Kafka bootstrap URL
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_API_KEY=your_kafka_api_key_here
KAFKA_API_SECRET=your_kafka_api_secret_here
KAFKA_OUTBREAK_TOPIC=outbreak_events
KAFKA_CONSUMER_GROUP_PO=pharmasense-po-generator
KAFKA_CONSUMER_GROUP_WA=pharmasense-whatsapp-notifier

# ── ML Model Artifacts ────────────────────────────────────────────────────────
STGNN_MODEL_PATH=ml/artifacts/stgnn_best.pt
GWN_MODEL_PATH=ml/artifacts/graphwavenet_best.pt
TFT_MODEL_PATH=ml/artifacts/tft_best.ckpt
NBEATS_MODEL_PATH=ml/artifacts/nbeats_ncd_latest.pt
PROPHET_MODEL_PATH=ml/artifacts/prophet_models.pkl
ANOMALY_MODEL_PATH=ml/artifacts/anomaly_detector.pkl
LGBM_MODEL_PATH=ml/artifacts/lgbm_demand.pkl
DISTRICT_INDEX_PATH=ml/data/district_index.json
ICMR_RULES_PATH=data/icmr_rules.json
DISEASE_DRUG_MAP_PATH=data/seed/disease_drug_map.csv

# ── Service URLs (internal — overridden in Docker Compose) ────────────────────
ML_SERVICE_GRPC_HOST=localhost:50051
ML_SERVICE_HTTP_HOST=http://localhost:8000
GATEWAY_HOST=localhost:8080

# ── App Config ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
